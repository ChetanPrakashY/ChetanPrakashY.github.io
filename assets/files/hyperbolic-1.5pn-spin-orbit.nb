         SuperscriptBox["er", "2"], "-", "1"}], ")"}]}]}], "]"}], ",", 
    "assumptions"}], "]"}]}]], "Input",ExpressionUUID->"9867e18c-f6bf-45e5-\
9ba5-7019fcf02782"],

