Cell["Checks", "Section",ExpressionUUID->"50ab71c8-aa4f-49bc-9cdd-8c9aac888a57"],

Cell["1. Bini, Geralico & Rettegno (2023)", "Subsection",ExpressionUUID->"5888693b-d4df-4a25-a0a3-6f635907f073"],

Cell["\<\
Their eqs. (14) and (8), arXiv:2307.12670, in our variables: Ebar = \
\[Minus]M2E/2, L = h, \[Nu] = eta, S = chiS (1 \[Minus] 2 eta) + delta chiA, \
S* = 2 eta chiS.\
\>", "Text",ExpressionUUID->"3c2168d0-c073-4c63-a505-74cada744543"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bini", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Eb", "=", 
        RowBox[{"-", 
         FractionBox["M2E", "2"]}]}], ",", 
       RowBox[{"L", "=", "h"}], ",", 
       RowBox[{"nu", "=", "eta"}], ",", 
       RowBox[{"S", "=", 
        RowBox[{
         RowBox[{"chiS", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"2", " ", "eta"}]}], ")"}]}], "+", 
         RowBox[{"delta", " ", "chiA"}]}]}], ",", 
       RowBox[{"Ss", "=", 
        RowBox[{"2", " ", "eta", " ", "chiS"}]}]}], "}"}], ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"e0", "=", 
          SqrtBox[
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "Eb", " ", 
             SuperscriptBox["L", "2"]}]}]]}], ",", "arB", ",", "erB", ",", 
         "rest"}], "}"}], ",", 
       RowBox[{
        RowBox[{"arB", "=", 
         FractionBox[
          RowBox[{"1", "+", 
           RowBox[{
            FractionBox["1", "2"], " ", 
            SuperscriptBox["Xi", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"7", "-", "nu"}], ")"}], " ", "Eb"}], "-", 
           FractionBox[
            RowBox[{
             SuperscriptBox["Xi", "3"], " ", 
             RowBox[{"(", 
              RowBox[{"2", " ", "Eb"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", " ", "S"}], "+", "Ss"}], ")"}]}], "L"]}], 
          RowBox[{"2", " ", "Eb"}]]}], ";", 
        RowBox[{"erB", "=", 
         RowBox[{"e0", "+", 
          FractionBox[
           RowBox[{
            SuperscriptBox["Xi", "2"], " ", "Eb", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "6"}], "+", "nu", "+", 
              RowBox[{
               FractionBox["5", "2"], " ", 
               RowBox[{"(", 
                RowBox[{"nu", "-", "3"}], ")"}], " ", "Eb", " ", 
               SuperscriptBox["L", "2"]}]}], ")"}]}], "e0"], "+", 
          FractionBox[
           RowBox[{
            SuperscriptBox["Xi", "3"], " ", "2", " ", "Eb", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", " ", "S"}], "+", 
              RowBox[{"2", " ", "Ss"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"4", " ", "S"}], "+", "Ss"}], ")"}], " ", "Eb", " ", 
               
               SuperscriptBox["L", "2"]}]}], ")"}]}], 
           RowBox[{"L", " ", "e0"}]]}]}], ";", 
        RowBox[{"rest", "=", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "+", 
             FractionBox[
              RowBox[{"3", " ", 
               SuperscriptBox["Xi", "2"]}], 
              RowBox[{"a", " ", 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox["e", "2"], "-", "1"}], ")"}]}]], "-", 
             FractionBox[
              RowBox[{
               SuperscriptBox["Xi", "3"], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"4", " ", "S"}], "+", 
                 RowBox[{"3", " ", "Ss"}]}], ")"}]}], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"a", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   SuperscriptBox["e", "2"], "-", "1"}], ")"}]}], ")"}], 
               RowBox[{"3", "/", "2"}]]]}], ",", 
            RowBox[{
             SuperscriptBox["a", 
              RowBox[{
               RowBox[{"-", "3"}], "/", "2"}]], "-", 
             FractionBox[
              RowBox[{
               SuperscriptBox["Xi", "2"], " ", 
               RowBox[{"(", 
                RowBox[{"nu", "-", "9"}], ")"}]}], 
              RowBox[{"2", " ", 
               SuperscriptBox["a", 
                RowBox[{"5", "/", "2"}]]}]], "-", 
             FractionBox[
              RowBox[{
               SuperscriptBox["Xi", "3"], " ", "3", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", " ", "S"}], "+", "Ss"}], ")"}]}], 
              RowBox[{"2", " ", 
               SuperscriptBox["a", "3"], " ", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox["e", "2"], "-", "1"}]]}]]}], ",", 
            RowBox[{"e", "-", 
             FractionBox[
              RowBox[{
               SuperscriptBox["Xi", "2"], " ", "e", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"3", " ", "nu"}], "-", "8"}], ")"}]}], 
              RowBox[{"2", " ", "a"}]], "-", 
             FractionBox[
              RowBox[{
               SuperscriptBox["Xi", "3"], " ", "e", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", " ", "S"}], "+", "Ss"}], ")"}]}], 
              RowBox[{
               SuperscriptBox["a", 
                RowBox[{"3", "/", "2"}]], " ", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox["e", "2"], "-", "1"}]]}]]}], ",", 
            RowBox[{"e", "-", 
             FractionBox[
              RowBox[{
               SuperscriptBox["Xi", "2"], " ", "nu", " ", "e"}], 
              RowBox[{"2", " ", "a"}]], "+", 
             FractionBox[
              RowBox[{
               SuperscriptBox["Xi", "3"], " ", "e", " ", "Ss"}], 
              RowBox[{
               SuperscriptBox["a", 
                RowBox[{"3", "/", "2"}]], " ", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox["e", "2"], "-", "1"}]]}]]}]}], "}"}], "/.", 
          "\[VeryThinSpace]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", "\[Rule]", "arB"}], ",", 
            RowBox[{"e", "\[Rule]", "erB"}]}], "}"}]}]}], ";", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"arB", ",", "erB"}], "}"}], ",", "rest"}], "]"}]}]}], 
      "]"}]}], "]"}]}], ";"}]], "Input",ExpressionUUID->"95389e60-82d4-4c6d-\
bcce-b7855e9f9cb2"],

