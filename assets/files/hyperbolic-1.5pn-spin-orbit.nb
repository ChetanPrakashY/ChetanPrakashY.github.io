     RowBox[{"(", 
      RowBox[{"s", "-", "sMinus"}], ")"}]}], "/.", "\[VeryThinSpace]", 
    "roots"}], "/.", "\[VeryThinSpace]", "polar"}], "]"}]], "Input",Expression\
UUID->"a8f5ba46-0238-4c80-8c1d-6539edcfcec7"],

