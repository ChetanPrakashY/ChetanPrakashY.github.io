       RowBox[{"{", 
        RowBox[{"2", ",", "5", ",", "10", ",", "20"}], "}"}]}]}], "}"}], ",", 
    
    RowBox[{
     RowBox[{
      RowBox[{"P", "[", "r_", "]"}], "=", 
      RowBox[{
       RowBox[{"rdot2", "/.", "\[VeryThinSpace]", "pars"}], "/.", 
       "\[VeryThinSpace]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Xi", "\[Rule]", "xi"}], ",", 
         RowBox[{"s", "\[Rule]", 
          FractionBox["1", "r"]}]}], "}"}]}]}], ";", 
     RowBox[{"rp", "=", 
      FractionBox["1", 
       RowBox[{"s", "/.", "\[VeryThinSpace]", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"rdot2", "/.", "\[VeryThinSpace]", "pars"}], "/.", 
             "\[VeryThinSpace]", 
             RowBox[{"Xi", "\[Rule]", "xi"}]}], ")"}], "\[Equal]", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"sP", "/.", "\[VeryThinSpace]", "pars"}], "/.", 
               "\[VeryThinSpace]", 
               RowBox[{"Xi", "\[Rule]", "xi"}]}], ",", "30"}], "]"}]}], "}"}],
           ",", 
          RowBox[{"WorkingPrecision", "\[Rule]", "30"}]}], "]"}]}]]}], ";", 
     RowBox[{"sol", "=", 
      RowBox[{"First", "[", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             SuperscriptBox["r", "\[Prime]\[Prime]",
              MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
            RowBox[{
             FractionBox["1", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                SubscriptBox["\[PartialD]", "x"], 
                RowBox[{"P", "[", "x", "]"}]}], "/.", "\[VeryThinSpace]", 
               RowBox[{"x", "\[Rule]", 
                RowBox[{"r", "[", "t", "]"}]}]}], ")"}]}]}], ",", 
           RowBox[{
            RowBox[{"r", "[", "0", "]"}], "\[Equal]", "rp"}], ",", 
           RowBox[{
            RowBox[{
             SuperscriptBox["r", "\[Prime]",
              MultilineFunction->None], "[", "0", "]"}], "\[Equal]", "0"}], ",", 
           RowBox[{
            RowBox[{
             SuperscriptBox["ph", "\[Prime]",
              MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"phidot", "/.", "\[VeryThinSpace]", "pars"}], "/.", 
              "\[VeryThinSpace]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Xi", "\[Rule]", "xi"}], ",", 
                RowBox[{"s", "\[Rule]", 
                 FractionBox["1", 
                  RowBox[{"r", "[", "t", "]"}]]}]}], "}"}]}], ")"}]}], ",", 
           RowBox[{
            RowBox[{"ph", "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "ph"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "21"}], "}"}], ",", 
         RowBox[{"WorkingPrecision", "\[Rule]", "30"}], ",", 
         RowBox[{"PrecisionGoal", "\[Rule]", "18"}], ",", 
         RowBox[{"AccuracyGoal", "\[Rule]", "18"}], ",", 
         RowBox[{"MaxSteps", "\[Rule]", "\[Infinity]"}]}], "]"}], "]"}]}], ";", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"q", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "ar", ",", "er", ",", "et", ",", "n", ",", "K", ",", "ephi"}],
                 "}"}], "/.", "\[VeryThinSpace]", "pars"}], "/.", 
              "\[VeryThinSpace]", 
              RowBox[{"Xi", "\[Rule]", "xi"}]}]}], ",", "uu"}], "}"}], ",", 
          RowBox[{
           RowBox[{"uu", "=", 
            RowBox[{"u", "/.", "\[VeryThinSpace]", 
             RowBox[{"FindRoot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                 "q", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], 
                 " ", "tt"}], "\[Equal]", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                  "q", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
                   " ", 
                  RowBox[{"Sinh", "[", "u", "]"}]}], "-", "u"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"u", ",", "1"}], "}"}], ",", 
               RowBox[{"WorkingPrecision", "\[Rule]", "30"}]}], "]"}]}]}], ";", 
           RowBox[{"Abs", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"r", "[", "tt", "]"}], "/.", "\[VeryThinSpace]", 
                 "sol"}], ")"}], "-", 
               RowBox[{
                RowBox[{
                "q", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                   "q", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], " ", 
                   RowBox[{"Cosh", "[", "uu", "]"}]}], "-", "1"}], ")"}]}]}], 
              ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"ph", "[", "tt", "]"}], "/.", "\[VeryThinSpace]", 
                 "sol"}], ")"}], "-", 
               RowBox[{"2", " ", 
                RowBox[{
                "q", "\[LeftDoubleBracket]", "5", "\[RightDoubleBracket]"}], " ", 
                RowBox[{"ArcTan", "[", 
                 RowBox[{
                  SqrtBox[
                   FractionBox[
                    RowBox[{
                    RowBox[{
                    "q", "\[LeftDoubleBracket]", "6", 
                    "\[RightDoubleBracket]"}], "+", "1"}], 
                    RowBox[{
                    RowBox[{
                    "q", "\[LeftDoubleBracket]", "6", 
                    "\[RightDoubleBracket]"}], "-", "1"}]]], " ", 
                  RowBox[{"Tanh", "[", 
                   FractionBox["uu", "2"], "]"}]}], "]"}]}]}]}], "}"}], 
            "]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"tt", ",", "times"}], "}"}]}], "]"}], "]"}]}]}], 
   "]"}]}]], "Input",ExpressionUUID->"e551aa59-1b83-4911-9416-00936cf44eb7"],

