Notebook[{
Cell["Hyperbolic orbits with spin\[Dash]orbit coupling at 1.5PN", "Title",ExpressionUUID->"9e18b1c4-2a87-49f5-98c3-269e551939a3"],

Cell["\<\
Chetan Prakash, 2025\[Dash]2026. Quasi-Keplerian parametrisation of an \
unbound compact binary whose spins are aligned with the orbital angular \
momentum, to leading order in the spin\[Dash]orbit coupling (1.5PN), in \
harmonic coordinates.\
\>", "Text",ExpressionUUID->"76ccad04-766f-4bb6-87c4-5a8405122fc3"],

Cell["\<\
Units G = m = 1, with Xi = 1/c counting PN orders. M2E = \[Minus]2E, where E \
is the energy per reduced mass, so M2E < 0 for a hyperbolic orbit. h is the \
angular momentum per reduced mass, eta the symmetric mass ratio, delta = (m1 \
\[Minus] m2)/m and chiS, chiA = (\[Chi]1 \[PlusMinus] \[Chi]2)/2.\
\>", "Text",ExpressionUUID->"6eb44396-40db-4fc4-9192-20842afa531d"],

Cell["Setup", "Section",ExpressionUUID->"2401fef9-48d3-40a4-a895-70f6f619f143"],

Cell[BoxData[
 RowBox[{
  RowBox[{"assumptions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"M2E", "<", "0"}], ",", 
     RowBox[{"h", ">", "0"}], ",", 
     RowBox[{"0", "<", "eta", "\[LessEqual]", 
      FractionBox["1", "4"]}], ",", 
     RowBox[{
      RowBox[{"-", "1"}], "<", "delta", "<", "1"}], ",", 
     RowBox[{"Xi", ">", "0"}]}], "}"}]}], ";"}]], "Input",ExpressionUUID->\
"1267de5c-f0c6-42a2-a653-5a2514f6aec2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ser", "[", "x_", "]"}], ":=", 
  RowBox[{"Normal", "[", 
   RowBox[{"Series", "[", 
    RowBox[{"x", ",", 
     RowBox[{"{", 
      RowBox[{"Xi", ",", "0", ",", "3"}], "}"}]}], "]"}], "]"}]}]], "Input",Ex\
pressionUUID->"34f0f377-bf0f-479c-b066-adf28faececd"],

Cell["\<\
Radial and angular equations from the conserved energy and angular momentum \
(Kidder 1995), written in s = 1/r: dr/dt squared and d\[Phi]/dt.\
\>", "Text",ExpressionUUID->"28fc5dd0-b90f-4761-96b1-044ffd19c65d"],

Cell[BoxData[
 RowBox[{"rdot2", "=", 
  RowBox[{"Expand", "[", 
   RowBox[{
    RowBox[{"-", "M2E"}], "+", 
    RowBox[{"2", " ", "s"}], "-", 
    RowBox[{
     SuperscriptBox["h", "2"], " ", 
     SuperscriptBox["s", "2"]}], "+", 
    RowBox[{
     SuperscriptBox["Xi", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["3", "4"]}], "+", 
          FractionBox[
           RowBox[{"9", " ", "eta"}], "4"]}], ")"}], " ", 
        SuperscriptBox["M2E", "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "10"}], "+", 
          RowBox[{"5", " ", "eta"}]}], ")"}], " ", 
        SuperscriptBox["s", "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"8", "-", 
          RowBox[{"3", " ", "eta"}]}], ")"}], " ", 
        SuperscriptBox["h", "2"], " ", 
        SuperscriptBox["s", "3"]}], "+", 
       RowBox[{"M2E", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"6", "-", 
             RowBox[{"7", " ", "eta"}]}], ")"}], " ", "s"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             RowBox[{"3", " ", "eta"}]}], ")"}], " ", 
           SuperscriptBox["h", "2"], " ", 
           SuperscriptBox["s", "2"]}]}], ")"}]}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["Xi", "3"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "eta", " ", "h", " ", "M2E", " ", 
        SuperscriptBox["s", "2"], " ", "chiS"}], "+", 
       RowBox[{"h", " ", 
        SuperscriptBox["s", "3"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "4"}], " ", "delta", " ", "chiA"}], "-", 
          RowBox[{"4", " ", "chiS"}], "+", 
          RowBox[{"4", " ", "eta", " ", "chiS"}]}], ")"}]}]}], ")"}]}]}], 
   "]"}]}]], "Input",ExpressionUUID->"c44dcb03-ed24-4545-86a3-34d8ba5edf30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "M2E"}], "+", 
  RowBox[{"2", " ", "s"}], "-", 
  RowBox[{
   SuperscriptBox["h", "2"], " ", 
   SuperscriptBox["s", "2"]}], "-", 
  FractionBox[
   RowBox[{"3", " ", 
    SuperscriptBox["M2E", "2"], " ", 
    SuperscriptBox["Xi", "2"]}], "4"], "+", 
  RowBox[{
   FractionBox["9", "4"], " ", "eta", " ", 
   SuperscriptBox["M2E", "2"], " ", 
   SuperscriptBox["Xi", "2"]}], "+", 
  RowBox[{"6", " ", "M2E", " ", "s", " ", 
   SuperscriptBox["Xi", "2"]}], "-", 
  RowBox[{"7", " ", "eta", " ", "M2E", " ", "s", " ", 
   SuperscriptBox["Xi", "2"]}], "-", 
  RowBox[{"10", " ", 
   SuperscriptBox["s", "2"], " ", 
   SuperscriptBox["Xi", "2"]}], "+", 
  RowBox[{"5", " ", "eta", " ", 
   SuperscriptBox["s", "2"], " ", 
   SuperscriptBox["Xi", "2"]}], "-", 
  RowBox[{
   SuperscriptBox["h", "2"], " ", "M2E", " ", 
   SuperscriptBox["s", "2"], " ", 
   SuperscriptBox["Xi", "2"]}], "+", 
  RowBox[{"3", " ", "eta", " ", 
   SuperscriptBox["h", "2"], " ", "M2E", " ", 
   SuperscriptBox["s", "2"], " ", 
   SuperscriptBox["Xi", "2"]}], "+", 
  RowBox[{"8", " ", 
   SuperscriptBox["h", "2"], " ", 
   SuperscriptBox["s", "3"], " ", 
   SuperscriptBox["Xi", "2"]}], "-", 
  RowBox[{"3", " ", "eta", " ", 
   SuperscriptBox["h", "2"], " ", 
   SuperscriptBox["s", "3"], " ", 
   SuperscriptBox["Xi", "2"]}], "-", 
  RowBox[{"2", " ", "chiS", " ", "eta", " ", "h", " ", "M2E", " ", 
   SuperscriptBox["s", "2"], " ", 
   SuperscriptBox["Xi", "3"]}], "-", 
  RowBox[{"4", " ", "chiS", " ", "h", " ", 
   SuperscriptBox["s", "3"], " ", 
   SuperscriptBox["Xi", "3"]}], "-", 
  RowBox[{"4", " ", "chiA", " ", "delta", " ", "h", " ", 
   SuperscriptBox["s", "3"], " ", 
   SuperscriptBox["Xi", "3"]}], "+", 
  RowBox[{"4", " ", "chiS", " ", "eta", " ", "h", " ", 
   SuperscriptBox["s", "3"], " ", 
   SuperscriptBox["Xi", "3"]}]}]], "Output",ExpressionUUID->"e55d2f52-d9ba-\
4a4c-99ad-2f842ea49e27"],

Cell[BoxData[
 RowBox[{"phidot", "=", 
  RowBox[{"Expand", "[", 
   RowBox[{
    RowBox[{"h", " ", 
     SuperscriptBox["s", "2"]}], "+", 
    RowBox[{
     FractionBox["1", "2"], " ", "h", " ", 
     SuperscriptBox["Xi", "2"], " ", 
     SuperscriptBox["s", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"M2E", "-", 
       RowBox[{"3", " ", "eta", " ", "M2E"}], "-", 
       RowBox[{"8", " ", "s"}], "+", 
       RowBox[{"4", " ", "eta", " ", "s"}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["Xi", "3"], " ", 
     SuperscriptBox["s", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "delta", " ", "s", " ", "chiA"}], "+", 
       RowBox[{"eta", " ", "M2E", " ", "chiS"}], "+", 
       RowBox[{"2", " ", "s", " ", "chiS"}], "-", 
       RowBox[{"4", " ", "eta", " ", "s", " ", "chiS"}]}], ")"}]}]}], 
   "]"}]}]], "Input",ExpressionUUID->"0cf983c0-530f-463a-9f88-28c41de4c316"],

Cell[BoxData[
 RowBox[{
  RowBox[{"h", " ", 
   SuperscriptBox["s", "2"]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", "h", " ", "M2E", " ", 
   SuperscriptBox["s", "2"], " ", 
   SuperscriptBox["Xi", "2"]}], "-", 
  RowBox[{
   FractionBox["3", "2"], " ", "eta", " ", "h", " ", "M2E", " ", 
   SuperscriptBox["s", "2"], " ", 
   SuperscriptBox["Xi", "2"]}], "-", 
  RowBox[{"4", " ", "h", " ", 
   SuperscriptBox["s", "3"], " ", 
   SuperscriptBox["Xi", "2"]}], "+", 
  RowBox[{"2", " ", "eta", " ", "h", " ", 
   SuperscriptBox["s", "3"], " ", 
   SuperscriptBox["Xi", "2"]}], "+", 
  RowBox[{"chiS", " ", "eta", " ", "M2E", " ", 
   SuperscriptBox["s", "2"], " ", 
   SuperscriptBox["Xi", "3"]}], "+", 
  RowBox[{"2", " ", "chiS", " ", 
   SuperscriptBox["s", "3"], " ", 
   SuperscriptBox["Xi", "3"]}], "+", 
  RowBox[{"2", " ", "chiA", " ", "delta", " ", 
   SuperscriptBox["s", "3"], " ", 
   SuperscriptBox["Xi", "3"]}], "-", 
  RowBox[{"4", " ", "chiS", " ", "eta", " ", 
   SuperscriptBox["s", "3"], " ", 
   SuperscriptBox["Xi", "3"]}]}]], "Output",ExpressionUUID->"c305f807-d6fe-\
4efa-881e-19b2b5753e5f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Q", "=", 
   RowBox[{"Expand", "[", 
    FractionBox["phidot", 
     SuperscriptBox["s", "2"]], "]"}]}], ";"}]], "Input",ExpressionUUID->\
"ce45d40c-5299-4b85-aab5-71ba59b4f9a0"],

Cell["Turning points", "Section",ExpressionUUID->"3a8d0184-bda1-4ee1-a735-0eb81b7ec7b7"],

Cell["\<\
dr/dt = 0 has one positive root s+ (periastron) and, since the orbit is \
unbound, one negative root s\[Minus]. Both are found order by order, starting \
from the Newtonian roots.\
\>", "Text",ExpressionUUID->"ed6e3157-d888-4326-8a0f-11c2648b2701"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sNewt", "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{"1", "+", 
       SqrtBox[
        RowBox[{"1", "-", 
         RowBox[{"M2E", " ", 
          SuperscriptBox["h", "2"]}]}]]}], 
      SuperscriptBox["h", "2"]], ",", 
     FractionBox[
      RowBox[{"1", "-", 
       SqrtBox[
        RowBox[{"1", "-", 
         RowBox[{"M2E", " ", 
          SuperscriptBox["h", "2"]}]}]]}], 
      SuperscriptBox["h", "2"]]}], "}"}]}], ";"}]], "Input",ExpressionUUID->\
"ce272fc4-4077-4240-abe3-a91106995e0f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"root", "[", "s0_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x2", ",", "x3", ",", "c"}], "}"}], ",", 
    RowBox[{
     RowBox[{"c", "=", 
      RowBox[{"CoefficientList", "[", 
       RowBox[{
        RowBox[{"ser", "[", 
         RowBox[{"rdot2", "/.", "\[VeryThinSpace]", 
          RowBox[{"s", "\[Rule]", 
           RowBox[{"s0", "+", 
            RowBox[{
             SuperscriptBox["Xi", "2"], " ", "x2"}], "+", 
            RowBox[{
             SuperscriptBox["Xi", "3"], " ", "x3"}]}]}]}], "]"}], ",", "Xi"}],
        "]"}]}], ";", 
     RowBox[{
      RowBox[{"s0", "+", 
       RowBox[{
        SuperscriptBox["Xi", "2"], " ", "x2"}], "+", 
       RowBox[{
        SuperscriptBox["Xi", "3"], " ", "x3"}]}], "/.", "\[VeryThinSpace]", 
      RowBox[{"First", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
            "c", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "\[Equal]",
             "0"}], ",", 
           RowBox[{
            RowBox[{
            "c", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], "\[Equal]",
             "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x2", ",", "x3"}], "}"}]}], "]"}], "]"}]}]}]}], 
   "]"}]}]], "Input",ExpressionUUID->"2c93bef7-ace1-420b-bf61-d147b77327e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sP", ",", "sM"}], "}"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"root", "/@", "sNewt"}], ",", "assumptions"}], "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"0316dbbf-c568-4dfc-9733-be3ce0157f69"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"ser", "[", 
       RowBox[{"rdot2", "/.", "\[VeryThinSpace]", 
        RowBox[{"s", "\[Rule]", "#1"}]}], "]"}], ",", "assumptions"}], "]"}], 
    "&"}], ")"}], "/@", 
  RowBox[{"{", 
   RowBox[{"sP", ",", "sM"}], "}"}]}]], "Input",ExpressionUUID->"7651dd7e-\
35be-44c3-8323-ca7be52c0fee"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",ExpressionUUID->"f8c59c2f-28fb-4574-9837-d36429080713"],

Cell["Radial orbital elements", "Section",ExpressionUUID->"fac68afd-2d68-4a17-b64e-7f955344bcb2"],

Cell["\<\
With r = ar (er cosh u \[Minus] 1), the periastron is at r = ar (er \[Minus] \
1) and the negative root corresponds to r = \[Minus]ar (er + 1).\
\>", "Text",ExpressionUUID->"14417f38-7cfc-4009-afd6-6dbe10426b53"],

Cell[BoxData[
 RowBox[{"ar", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"ser", "[", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], " ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "sP"], "+", 
        FractionBox["1", "sM"]}], ")"}]}], "]"}], ",", "assumptions"}], 
   "]"}]}]], "Input",ExpressionUUID->"dba12d27-8743-413d-8146-9e17148da88a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", "M2E"]}], "-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["Xi", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "7"}], "+", "eta"}], ")"}], " ", "h"}], "+", 
      RowBox[{"8", " ", 
       RowBox[{"(", 
        RowBox[{"chiS", "+", 
         RowBox[{"chiA", " ", "delta"}], "-", 
         RowBox[{"chiS", " ", "eta"}]}], ")"}], " ", "Xi"}]}], ")"}]}], 
   RowBox[{"4", " ", "h"}]]}]], "Output",ExpressionUUID->"70b0792e-1b11-4db6-\
9de9-c279ff449ec6"],

Cell[BoxData[
 RowBox[{"er", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"ser", "[", 
     FractionBox[
      RowBox[{
       FractionBox["1", "sM"], "-", 
       FractionBox["1", "sP"]}], 
      RowBox[{
       FractionBox["1", "sP"], "+", 
       FractionBox["1", "sM"]}]], "]"}], ",", "assumptions"}], 
   "]"}]}]], "Input",ExpressionUUID->"40e1abc8-2388-4e27-9f4e-0dafaaa3fbf2"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{"8", " ", "h", " ", 
    SqrtBox[
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["h", "2"], " ", "M2E"}]}]]}]], 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "32"}], " ", 
     RowBox[{"(", 
      RowBox[{"chiS", "+", 
       RowBox[{"chiA", " ", "delta"}], "-", 
       RowBox[{"chiS", " ", "eta"}]}], ")"}], " ", "M2E", " ", 
     SuperscriptBox["Xi", "3"]}], "+", 
    RowBox[{"8", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "chiA", " ", "delta"}], "+", 
       RowBox[{"chiS", " ", 
        RowBox[{"(", 
         RowBox[{"2", "-", 
          RowBox[{"3", " ", "eta"}]}], ")"}]}]}], ")"}], " ", 
     SuperscriptBox["h", "2"], " ", 
     SuperscriptBox["M2E", "2"], " ", 
     SuperscriptBox["Xi", "3"]}], "+", 
    RowBox[{"h", " ", 
     RowBox[{"(", 
      RowBox[{"8", "-", 
       RowBox[{"4", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "6"}], "+", "eta"}], ")"}], " ", "M2E", " ", 
        SuperscriptBox["Xi", "2"]}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["h", "3"], " ", "M2E", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "8"}], "+", 
       RowBox[{"5", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "+", "eta"}], ")"}], " ", "M2E", " ", 
        SuperscriptBox["Xi", "2"]}]}], ")"}]}]}], ")"}]}]], "Output",Expressio\
nUUID->"ca55dc53-dd41-4015-9c57-9c63945ae995"],

Cell["Factoring dr/dt", "Section",ExpressionUUID->"7e0f2bb4-4d98-42a7-8702-a7ae3684940c"],

Cell["\<\
Divide out the two roots: (dr/dt)^2 = (s+ \[Minus] s)(s \[Minus] s\[Minus]) \
A(s). At this order A is linear in s, so 1/Sqrt[A] = b0 + b1 s.\
\>", "Text",ExpressionUUID->"8c5b2b29-57dd-420a-848a-eb0b8502eb5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Aq", ",", "Arem"}], "}"}], "=", 
   RowBox[{"PolynomialQuotientRemainder", "[", 
    RowBox[{"rdot2", ",", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"sP", "-", "s"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"s", "-", "sM"}], ")"}]}], "]"}], ",", "s"}], "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"2c89ec4c-4bb7-40fc-b42e-d92991bec79e"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"ser", "[", "Arem", "]"}], ",", "assumptions"}], "]"}]], "Input",Ex\
pressionUUID->"d9f0ab7a-b53f-436a-84ea-71f2959bbd60"],

Cell[BoxData["0"], "Output",ExpressionUUID->"2b612757-2303-4043-b747-2578e00e5302"],

Cell[BoxData[
 RowBox[{
  RowBox[{"invSqrtA", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"ser", "[", 
      FractionBox["1", 
       SqrtBox[
        RowBox[{"ser", "[", "Aq", "]"}]]], "]"}], ",", "assumptions"}], 
    "]"}]}], ";"}]], "Input",ExpressionUUID->"85fd839a-ef4a-471c-8153-\
9575bfecabdb"],

Cell[BoxData[
 RowBox[{"bVal", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"b0", "\[Rule]", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"invSqrtA", ",", "s", ",", "0"}], "]"}], ",", "assumptions"}],
       "]"}]}], ",", 
    RowBox[{"b1", "\[Rule]", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"invSqrtA", ",", "s", ",", "1"}], "]"}], ",", "assumptions"}],
       "]"}]}]}], "}"}]}]], "Input",ExpressionUUID->"a6acd58e-ec28-4df7-81ec-\
48043190e942"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"b0", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "6"}], "+", "eta"}], ")"}], " ", "h", " ", 
        SuperscriptBox["Xi", "2"]}], "+", 
       RowBox[{"8", " ", 
        RowBox[{"(", 
         RowBox[{"chiS", "+", 
          RowBox[{"chiA", " ", "delta"}], "-", 
          RowBox[{"chiS", " ", "eta"}]}], ")"}], " ", 
        SuperscriptBox["Xi", "3"]}], "+", 
       RowBox[{"2", " ", "chiS", " ", "eta", " ", 
        SuperscriptBox["h", "2"], " ", "M2E", " ", 
        SuperscriptBox["Xi", "3"]}], "+", 
       RowBox[{
        SuperscriptBox["h", "3"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"3", " ", "eta"}]}], ")"}], " ", "M2E", " ", 
           SuperscriptBox["Xi", "2"]}]}], ")"}]}]}], 
      RowBox[{"2", " ", 
       SuperscriptBox["h", "4"]}]]}]}], ",", 
   RowBox[{"b1", "\[Rule]", 
    FractionBox[
     RowBox[{
      SuperscriptBox["Xi", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"8", "-", 
           RowBox[{"3", " ", "eta"}]}], ")"}], " ", "h"}], "-", 
        RowBox[{"4", " ", 
         RowBox[{"(", 
          RowBox[{"chiS", "+", 
           RowBox[{"chiA", " ", "delta"}], "-", 
           RowBox[{"chiS", " ", "eta"}]}], ")"}], " ", "Xi"}]}], ")"}]}], 
     RowBox[{"2", " ", 
      SuperscriptBox["h", "2"]}]]}]}], "}"}]], "Output",ExpressionUUID->\
"498e321b-df4c-4484-b82c-85bac551c7a8"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"invSqrtA", "-", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"b0", "+", 
      RowBox[{"b1", " ", "s"}]}], "/.", "\[VeryThinSpace]", "bVal"}], ")"}]}],
   "]"}]], "Input",ExpressionUUID->"5ca04fc8-365d-42bb-9f1e-8215eb52717c"],

Cell[BoxData["0"], "Output",ExpressionUUID->"0032c452-5937-4a0c-bdc7-9e4a3ddd231c"],

Cell["Kepler equation", "Section",ExpressionUUID->"ba4ec92b-87f3-43e7-934b-7848ec6ddd0b"],

Cell["\<\
On the orbit s = 1/(a (e cosh u \[Minus] 1)), with 1/s+ = a (e \[Minus] 1) \
and 1/s\[Minus] = \[Minus]a (e + 1). Then dt = dr/(dr/dt) becomes an \
elementary integral in u (u > 0, outgoing branch).\
\>", "Text",ExpressionUUID->"1d182a5a-d8ce-4220-8489-e9af709cdaf0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"roots", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"sPlus", "\[Rule]", 
      FractionBox["1", 
       RowBox[{"a", " ", 
        RowBox[{"(", 
         RowBox[{"e", "-", "1"}], ")"}]}]]}], ",", 
     RowBox[{"sMinus", "\[Rule]", 
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"a", " ", 
         RowBox[{"(", 
          RowBox[{"e", "+", "1"}], ")"}]}]]}]}]}], "}"}]}], ";"}]], "Input",Ex\
pressionUUID->"6d927b91-d0e1-4371-88fd-ba389a9c8b07"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hypOrbit", "=", 
   RowBox[{"{", 
    RowBox[{"s", "\[Rule]", 
     FractionBox["1", 
      RowBox[{"a", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"e", " ", 
          RowBox[{"Cosh", "[", "u", "]"}]}], "-", "1"}], ")"}]}]]}], "}"}]}], 
  ";"}]], "Input",ExpressionUUID->"0d994cde-cdf3-4baf-aa25-cd7b65261eaf"],

