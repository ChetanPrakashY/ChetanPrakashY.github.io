     RowBox[{"(", 
      RowBox[{"s", "-", "sMinus"}], ")"}]}], "/.", "\[VeryThinSpace]", 
    "roots"}], "/.", "\[VeryThinSpace]", "hypOrbit"}], "]"}]], "Input",Express\
ionUUID->"a89251a9-4c2f-4690-bc7c-b3fbd3168c93"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["e", "2"], " ", 
