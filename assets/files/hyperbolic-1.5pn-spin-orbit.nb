     RowBox[{"chiA", "\[Rule]", 
      RowBox[{"-", 
       FractionBox["1", "5"]}]}]}], "}"}]}], ";"}]], "Input",ExpressionUUID->\
"49a18e21-0bf3-400c-b011-970034c53ed9"],

