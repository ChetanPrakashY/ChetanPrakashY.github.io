Cell["\<\
At fixed u, v = 2 arctan[Sqrt[(e + 1)/(e \[Minus] 1)] tanh(u/2)] depends on e \
through \[PartialD]v/\[PartialD]e = \[Minus]sin v/(e^2 \[Minus] 1):\
\>", "Text",ExpressionUUID->"309dfd2e-15e3-4687-85c0-bc380d1f6f3d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vOf", "[", "ecc_", "]"}], ":=", 
  RowBox[{"2", " ", 
   RowBox[{"ArcTan", "[", 
    RowBox[{
     SqrtBox[
      FractionBox[
       RowBox[{"ecc", "+", "1"}], 
       RowBox[{"ecc", "-", "1"}]]], " ", 
     RowBox[{"Tanh", "[", 
      FractionBox["u", "2"], "]"}]}], "]"}]}]}]], "Input",ExpressionUUID->\
"8fde9c8b-a23e-4a12-b116-d37e1bb24109"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrigExpand", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "e"], 
      RowBox[{"vOf", "[", "e", "]"}]}], "+", 
     FractionBox[
      RowBox[{"Sin", "[", 
       RowBox[{"vOf", "[", "e", "]"}], "]"}], 
      RowBox[{
       SuperscriptBox["e", "2"], "-", "1"}]]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"e", ">", "1"}], ",", 
     RowBox[{"u", ">", "0"}]}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"33fe79ad-ccba-4bd7-b6f9-58c249867583"],

Cell[BoxData["0"], "Output",ExpressionUUID->"77793516-f240-4d9c-bcf7-f6911c36514d"],

Cell["\<\
So v + F sin v is the same function evaluated at e\[Phi] = er \[Minus] F \
(er^2 \[Minus] 1), and \[Phi] \[Minus] \[Phi]0 = 2K arctan[Sqrt[(e\[Phi] + \
1)/(e\[Phi] \[Minus] 1)] tanh(u/2)] up to 2PN terms.\
\>", "Text",ExpressionUUID->"28960abd-7a6a-42ce-b669-8ff60461b30d"],

