 RowBox[{
  RowBox[{"phiOfu", "=", 
   RowBox[{
    RowBox[{"phiOfv", "/.", "\[VeryThinSpace]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "\[Rule]", "ar"}], ",", 
       RowBox[{"e", "\[Rule]", "er"}]}], "}"}]}], "/.", "\[VeryThinSpace]", 
    RowBox[{"v", "\[Rule]", 
     RowBox[{"vOf", "[", "er", "]"}]}]}]}], ";"}]], "Input",ExpressionUUID->\
"99f5f057-2169-4ac4-a5c6-288fec090e4c"],

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"0", ",", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"CoefficientList", "[", 
       RowBox[{
        RowBox[{"ser", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"K", " ", 
            RowBox[{"vOf", "[", "ephi", "]"}]}], "-", "phiOfu"}], "/.", 
          "\[VeryThinSpace]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"M2E", "\[Rule]", 
             RowBox[{"-", 
              RowBox[{"RandomReal", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  FractionBox["1", "10"], ",", "1"}], "}"}], ",", 
                RowBox[{"WorkingPrecision", "\[Rule]", "40"}]}], "]"}]}]}], ",", 
            RowBox[{"h", "\[Rule]", 
             RowBox[{"RandomReal", "[", 
